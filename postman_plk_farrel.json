{
	"info": {
		"_postman_id": "farrel-plk-testing-collection",
		"name": "PLK Farrel - Testing Collection",
		"description": "Postman collection untuk testing fitur Scheduled Publish dan Manajemen User (CRUD) sesuai Laporan PLK Farrel Aqeel Danendra.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000/api",
			"type": "string"
		},
		{
			"key": "admin_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "article_id",
			"value": "",
			"type": "string"
		},
		{
			"key": "user_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. Auth - Login Admin",
			"item": [
				{
					"name": "Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has access_token', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('access_token');",
									"    pm.collectionVariables.set('admin_token', jsonData.data.access_token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@klojen.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "1. Scheduled Publish",
			"item": [
				{
					"name": "1.1 Jadwalkan Artikel (Schedule)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Article status is scheduled', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.status).to.eql('scheduled');",
									"});",
									"",
									"pm.test('Response has scheduled_at', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('published_at');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"scheduled\",\n    \"scheduled_at\": \"{{$isoTimestamp}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/cms/articles/{{article_id}}/status",
							"host": ["{{base_url}}"],
							"path": ["cms", "articles", "{{article_id}}", "status"]
						},
						"description": "Schedule artikel untuk dipublish otomatis. Ganti {{article_id}} dengan ID artikel yang valid dan scheduled_at dengan waktu > 5 menit dari sekarang."
					}
				},
				{
					"name": "1.2 Verifikasi Artikel Scheduled",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Article status is scheduled', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.status).to.eql('scheduled');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/cms/articles/{{article_id}}",
							"host": ["{{base_url}}"],
							"path": ["cms", "articles", "{{article_id}}"]
						},
						"description": "Verifikasi artikel sudah berstatus scheduled."
					}
				},
				{
					"name": "1.3 Validasi Waktu Minimal 5 Menit",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 400 (waktu terlalu dekat)', function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"",
									"pm.test('Error code is SCHEDULED_TIME_TOO_SOON', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.error).to.eql('SCHEDULED_TIME_TOO_SOON');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"scheduled\",\n    \"scheduled_at\": \"2026-06-17T12:01:00Z\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/cms/articles/{{article_id}}/status",
							"host": ["{{base_url}}"],
							"path": ["cms", "articles", "{{article_id}}", "status"]
						},
						"description": "Test validasi: scheduled_at harus > 5 menit dari sekarang. Ganti waktu dengan waktu yang < 5 menit dari sekarang."
					}
				},
				{
					"name": "1.4 Batalkan Jadwal (Cancel Schedule)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Article status changed to draft', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.status).to.eql('draft');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"draft\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/cms/articles/{{article_id}}/status",
							"host": ["{{base_url}}"],
							"path": ["cms", "articles", "{{article_id}}", "status"]
						},
						"description": "Batalkan jadwal dengan mengubah status kembali ke draft."
					}
				},
				{
					"name": "1.5 Jalankan Cron Manual (Publish Scheduled)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Note: Ini dijalankan via terminal, bukan REST API",
									"// Command: php artisan articles:publish-scheduled",
									"// Request ini hanya placeholder untuk dokumentasi",
									"",
									"pm.test('Placeholder - jalankan via terminal', function () {",
									"    pm.expect(true).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/ping",
							"host": ["{{base_url}}"],
							"path": ["ping"]
						},
						"description": "PLACEHOLDER: Jalankan command ini di terminal:\n\n```\ncd backend\nphp artisan articles:publish-scheduled\n```\n\nExpected output: jumlah artikel yang berhasil di-publish."
					}
				}
			]
		},
